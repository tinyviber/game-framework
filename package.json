{
  "name": "game-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --environment node",
    "assets:verify": "bash asset-research/scripts/research-assets.sh verify",
    "assets:prepare-local": "bash asset-research/scripts/research-assets.sh prepare --write-local",
    "assets:preview-local": "bash asset-research/scripts/research-assets.sh preview --write-local",
    "assets:analyze-local": "bash asset-research/scripts/research-assets.sh analyze --write-local",
    "assets:benchmark-local": "bash asset-research/scripts/research-assets.sh benchmark --write-local",
    "assets:benchmark-cc0": "node asset-research/scripts/render-cc0-smoke.mjs --verify"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  }
}
